# Copy to site_new/.env (gitignored) and fill in. Run scripts: node --env-file=.env <script>.mjs
# Server env vars must ALSO be set in the Vercel project settings.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/postgres
RACING_API_USER=
RACING_API_PASS=
RESEND_API_KEY=
# Server-only (set in Vercel, not needed for local .mjs scripts):
JWT_SECRET=
ADMIN_SECRET=
CRON_SECRET=
