{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/mobile", "destination": "/mobile.html" },
    { "source": "/((?!api|mobile).*)", "destination": "/index.html" }
  ],
  "crons": [
    {
      "path": "/api/cron/race-day-pipeline",
      "schedule": "*/5 * * * *"
    }
  ]
}
