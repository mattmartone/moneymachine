{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/monmouth", "destination": "/api/monmouth" },
    { "source": "/saratoga", "destination": "/api/saratoga" },
    { "source": "/execution", "destination": "/api/execution" },
    { "source": "/new-mobile", "destination": "/api/new-mobile" },
    { "source": "/mobile", "destination": "/mobile/index.html" },
    { "source": "/mobile/assets/(.*)", "destination": "/mobile/assets/$1" },
    { "source": "/mobile/(.*)", "destination": "/mobile/index.html" },
    { "source": "/signin", "destination": "/signin.html" },
    { "source": "/verify", "destination": "/verify.html" },
    { "source": "/old-landing/(.*)", "destination": "/old-landing.html" }
  ],
  "crons": [
    {
      "path": "/api/cron/race-day-pipeline",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/scratch-monitor",
      "schedule": "*/5 * * * *"
    }
  ]
}
