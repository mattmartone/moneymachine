DATABASE_URL=your_supabase_connection_string
BRISNET_USER=your_brisnet_username
BRISNET_PASS=your_brisnet_password
SLACK_WEBHOOK_URL=your_slack_webhook_url
# Optional: needed only to post the actual cart screenshot IMAGE to Slack.
# Incoming webhooks are text-only; image upload requires a bot token.
# Bot scopes required: files:write, chat:write. Get channel ID from the channel details.
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
POLL_INTERVAL_MS=300000
AUTO_APPROVE=false
# When AUTO_APPROVE=false, the agent posts the cart to Slack and waits for a ✅ reaction.
# On approval it only SUBMITS the order (spends money) if this is true; otherwise it
# just confirms receipt of the approval (safe test mode).
SUBMIT_ON_APPROVAL=false
